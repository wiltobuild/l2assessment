# Groq API Configuration (FREE!)
# Get your free API key from: https://console.groq.com/keys
#
# The key is read by the server only (no VITE_ prefix), so it is never
# included in the code sent to the browser.

GROQ_API_KEY=your_groq_api_key_here

# Optional: model used for categorization. It must support strict JSON-schema
# structured outputs (https://console.groq.com/docs/structured-outputs).
# GROQ_MODEL=openai/gpt-oss-20b
